// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../lib/prisma-master"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            Int      @id @default(autoincrement())
  name          String
  databaseUrl   String
  createdAt     DateTime @default(now())
  neonProjectId String
  pineconeIndex String?
}
